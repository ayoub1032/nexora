<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.UserAssetsMarketController"
            fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: transparent;">

    <VBox spacing="24" style="-fx-padding: 32;">
        <Label text="Asset Market" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1e293b;"/>
        <Label text="Trade real-time digital assets directly from your account." styleClass="small-label"/>

        <GridPane hgap="24" vgap="24">
            <columnConstraints>
                <ColumnConstraints percentWidth="60"/>
                <ColumnConstraints percentWidth="40"/>
            </columnConstraints>

            <!-- LEFT: AVAILABLE ASSETS & CHART -->
            <VBox spacing="16" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Live Market Listing" styleClass="section-title"/>
                <TableView fx:id="assetsTable" styleClass="table-view" VBox.vgrow="ALWAYS" style="-fx-min-height: 250px;">
                    <columns>
                        <TableColumn fx:id="colAssetId" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colAssetName" text="Name" prefWidth="120"/>
                        <TableColumn fx:id="colAssetSymbol" text="Symbol" prefWidth="80" style="-fx-alignment: CENTER; -fx-font-weight: 800;"/>
                        <TableColumn fx:id="colAssetValue" text="Current Price" prefWidth="100" style="-fx-alignment: CENTER-RIGHT; -fx-text-fill: #0d9488;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- PRICE EVOLUTION CHART -->
                <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS" style="-fx-min-height: 250px; -fx-padding: 16;">
                    <Label fx:id="lblChartTitle" text="Select an asset to view its 30-day history" styleClass="section-title" style="-fx-font-size: 16px;"/>
                    <LineChart fx:id="priceChart" legendVisible="false" VBox.vgrow="ALWAYS" createSymbols="false">
                        <xAxis>
                            <CategoryAxis fx:id="xAxis" animated="false"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis" forceZeroInRange="false" animated="false"/>
                        </yAxis>
                    </LineChart>
                </VBox>
            </VBox>

            <!-- RIGHT: CREATE ORDER -->
            <VBox spacing="16" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="card" style="-fx-min-height: 450px;">
                <Label text="Execute Trade" styleClass="section-title"/>
                
                <Label fx:id="lblMsg" text="" styleClass="label-error" wrapText="true"/>

                <VBox spacing="8" style="-fx-padding: 16 0 0 0;">
                    <Label text="Select Asset" styleClass="small-label"/>
                    <ComboBox fx:id="cbAsset" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Quantity" styleClass="small-label"/>
                    <TextField fx:id="tfQuantity" promptText="e.g. 5"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Estimated Total" styleClass="small-label"/>
                    <TextField fx:id="tfPrice" promptText="0.00" disable="true" style="-fx-text-fill: #0d9488; -fx-font-weight: 800;"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Order Type" styleClass="small-label"/>
                    <ComboBox fx:id="cbOrderType" maxWidth="Infinity"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="12">
                    <Button onAction="#createOrder" text="Submit Order" styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#clearFields" text="Clear" styleClass="btn-ghost" style="-fx-border-color: #cbd5e1;"/>
                </HBox>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
