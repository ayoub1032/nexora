<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.UserTransactionsController"
            fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: transparent;">

    <VBox spacing="24" style="-fx-padding: 32;" VBox.vgrow="ALWAYS">
        <Label text="Transaction Ledger" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1e293b;"/>
        <Label text="A record of all your deposits, withdrawals, and asset trades." styleClass="small-label"/>
        
        <Label fx:id="lblMsg" text=""/>
        
        <TableView fx:id="transactionsTable" styleClass="table-view" VBox.vgrow="ALWAYS" style="-fx-min-height: 500px;">
            <columns>
                <TableColumn fx:id="colTxId" text="TX ID" prefWidth="100" style="-fx-alignment: CENTER; -fx-text-fill: #64748b;"/>
                <TableColumn fx:id="colTxType" text="Type" prefWidth="120" style="-fx-alignment: CENTER; -fx-font-weight: 800;"/>
                <TableColumn fx:id="colTxAmount" text="Amount" prefWidth="150" style="-fx-alignment: CENTER-RIGHT; -fx-font-size: 15px;"/>
                <TableColumn fx:id="colTxStatus" text="Status" prefWidth="120" style="-fx-alignment: CENTER; -fx-text-fill: #10b981;"/>
                <TableColumn fx:id="colTxDate" text="Date &amp; Time" prefWidth="200" style="-fx-alignment: CENTER-RIGHT;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</ScrollPane>
