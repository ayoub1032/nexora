<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AdminViewController"
            styleClass="admin-page">

    <!-- TOP NAVBAR -->
    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="admin-topbar">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>

            <!-- Brand -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="N" styleClass="brand-badge"/>
                <Label text="NEXORA" styleClass="brand-title"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Nav (design only) -->
            <HBox spacing="10" alignment="CENTER">
                <Label text="Dashboard" styleClass="nav-item"/>
                <Label text="Operations" styleClass="nav-item-active"/>
                <Label text="Analytics" styleClass="nav-item"/>
                <Label text="Settings" styleClass="nav-item"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Back (existing action) -->
            <Button text="Retour" onAction="#back" styleClass="btn-ghost"/>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="admin-scroll">
            <content>
                <VBox spacing="16" styleClass="admin-content">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Operations Overview" styleClass="page-title"/>
                            <Label text="Manage wallets and monitor transactions activity." styleClass="page-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Design buttons -->
                        <Button text="Export Report" styleClass="btn-ghost"/>
                        <!-- This can map to create wallet -->
                        <Button text="+ New Wallet" onAction="#openCreateWalletWindow" styleClass="btn-primary"/>
                    </HBox>

                    <!-- KPI Cards (design only, values static) -->
                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" styleClass="kpi-card" spacing="6">
                            <Label text="Total Wallets" styleClass="kpi-title"/>
                            <Label fx:id="lblTotalKpiWallets" text="—" styleClass="kpi-value"/>
                            <Label text="Auto (table below)" styleClass="kpi-hint"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1" styleClass="kpi-card" spacing="6">
                            <Label text="Total Balance" styleClass="kpi-title"/>
                            <Label fx:id="lblTotalKpiBalance" text="—" styleClass="kpi-value"/>
                            <Label text="Auto (sum in future)" styleClass="kpi-hint"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2" styleClass="kpi-card" spacing="6">
                            <Label text="Transactions" styleClass="kpi-title"/>
                            <Label fx:id="lblTotalKpiTx" text="—" styleClass="kpi-value"/>
                            <Label text="Auto (table below)" styleClass="kpi-hint"/>
                        </VBox>

                        <VBox GridPane.columnIndex="3" styleClass="kpi-card" spacing="6">
                            <Label text="System Status" styleClass="kpi-title"/>
                            <Label text="Healthy" styleClass="kpi-value-green"/>
                            <Label text="Database connected" styleClass="kpi-hint"/>
                        </VBox>
                    </GridPane>

                    <!-- Main grid: left tables + right side panels -->
                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="68"/>
                            <ColumnConstraints percentWidth="32"/>
                        </columnConstraints>

                        <!-- LEFT COLUMN: Wallets + Transactions -->
                        <VBox GridPane.columnIndex="0" spacing="12">

                            <!-- Wallet Card -->
                            <VBox spacing="10" styleClass="card-light">
                                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Wallets" styleClass="section-title"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button text="Refresh" onAction="#refreshWallets" styleClass="btn-ghost"/>
                                    <Button text="Delete" onAction="#deleteWallet" styleClass="btn-danger"/>
                                    <Button text="Clear" onAction="#clearSelection" styleClass="btn-ghost"/>
                                </HBox>

                                <!-- existing message label -->
                                <Label fx:id="lblWalletMsg" text="" styleClass="note"/>

                                <!-- existing walletTable fx:id kept -->
                                <TableView fx:id="walletTable" prefHeight="280" styleClass="table-light">
                                    <columns>
                                        <TableColumn fx:id="colWalletId" text="wallet_id" prefWidth="120"/>
                                        <TableColumn fx:id="colUserId" text="user_id" prefWidth="120"/>
                                        <TableColumn fx:id="colBalance" text="balance" prefWidth="180"/>
                                        <TableColumn fx:id="colReserved" text="reserved_balance" prefWidth="180"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <!-- Transactions Card -->
                            <VBox spacing="10" styleClass="card-light">
                                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Transaction History" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Refresh" onAction="#refreshTx" styleClass="btn-ghost"/>
                                </HBox>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Filter wallet_id:" styleClass="small-label"/>
                                    <TextField fx:id="tfFilterWalletId" promptText="ex: 2" prefWidth="180" styleClass="input-light"/>
                                    <Button text="Apply" onAction="#filterTx" styleClass="btn-primary"/>
                                    <Button text="Reset" onAction="#refreshTx" styleClass="btn-ghost"/>
                                </HBox>

                                <!-- existing tx message label -->
                                <Label fx:id="lblTxMsg" text="" styleClass="note"/>

                                <!-- existing txTable fx:id kept -->
                                <TableView fx:id="txTable" prefHeight="360" styleClass="table-light">
                                    <columns>
                                        <TableColumn fx:id="colTxId" text="transaction_id" prefWidth="120"/>
                                        <TableColumn fx:id="colTxWalletId" text="wallet_id" prefWidth="100"/>
                                        <TableColumn fx:id="colTxAmount" text="amount" prefWidth="140"/>
                                        <TableColumn fx:id="colTxType" text="type" prefWidth="120"/>
                                        <TableColumn fx:id="colTxRef" text="reference_id" prefWidth="130"/>
                                        <TableColumn fx:id="colTxStatus" text="status" prefWidth="110"/>
                                        <TableColumn fx:id="colTxCreated" text="created_at" prefWidth="180"/>
                                    </columns>
                                </TableView>
                            </VBox>

                        </VBox>

                        <!-- RIGHT COLUMN: Side cards (design only) -->
                        <VBox GridPane.columnIndex="1" spacing="12">

                            <VBox spacing="10" styleClass="card-light">
                                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                <Label text="Order Tracking" styleClass="section-title"/>
                                <Label text="• Wallet created events (admin)" styleClass="small-muted"/>
                                <Label text="• Deposits / Withdrawals (user demo)" styleClass="small-muted"/>
                                <Label text="• Filters &amp; exports (later)" styleClass="small-muted"/>
                            </VBox>

                            <VBox spacing="10" styleClass="card-light">
                                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Activity Logs" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Hyperlink text="VIEW" onAction="#viewLogs" styleClass="link"/>
                                </HBox>
                                <Label text="• Admin opened dashboard" styleClass="small-muted"/>
                                <Label text="• Wallet list refreshed" styleClass="small-muted"/>
                                <Label text="• Transactions filtered" styleClass="small-muted"/>
                            </VBox>

                            <VBox spacing="10" styleClass="card-accent">
                                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                <Label text="Need immediate support?" styleClass="section-title-white"/>
                                <Label text="Contact your team for critical issues." styleClass="small-muted-white"/>
                                <Button text="Open Support Ticket" styleClass="btn-white"/>
                            </VBox>

                        </VBox>
                    </GridPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>