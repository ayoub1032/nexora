<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.OrderViewController">

    <top>
        <VBox spacing="10" styleClass="content-header">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label text="Orders Management" styleClass="title"/>
            <HBox spacing="10">
                <TextField fx:id="tfFilterUserId" promptText="Filter by User ID..." HBox.hgrow="ALWAYS"/>
                <Button onAction="#refreshOrders" text="🔄 Refresh" styleClass="btn-primary"/>
                <Button onAction="#back" text="← Back" styleClass="btn-ghost"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="12" style="-fx-padding: 16px;">
                <TableView fx:id="orderTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colOrderId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colAssetId" text="Asset ID" prefWidth="70"/>
                        <TableColumn fx:id="colUserId" text="User ID" prefWidth="70"/>
                        <TableColumn fx:id="colQuantity" text="Quantity" prefWidth="80"/>
                        <TableColumn fx:id="colPrice" text="Price" prefWidth="80"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="10" styleClass="form-container" style="-fx-margin: 16px;">
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Asset ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="tfAssetId" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="User ID:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="tfUserId" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Quantity:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="tfQuantity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="tfPrice" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Type (BUY/SELL):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cbType" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label fx:id="lblMsg" text="" styleClass="label-error" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5"/>

                <HBox spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="6">
                    <Button onAction="#addOrder" text="➕ Add" styleClass="btn-primary"/>
                    <Button onAction="#updateOrder" text="✏️ Update" styleClass="btn-primary"/>
                    <Button onAction="#deleteOrder" text="🗑️ Delete" styleClass="btn-danger"/>
                    <Button onAction="#clearFields" text="Clear" styleClass="btn-ghost"/>
                </HBox>
            </GridPane>
        </VBox>
    </bottom>

</BorderPane>
