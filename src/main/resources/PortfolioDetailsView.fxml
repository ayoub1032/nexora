<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="tn.esprit.controllers.PortfolioDetailsViewController"
      style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-padding: 20;">

    <!-- Header -->
    <HBox spacing="15" style="-fx-alignment: center_left; -fx-padding: 20; 
             -fx-background-color: rgba(0, 0, 0, 0.1); -fx-border-radius: 10; 
             -fx-background-radius: 10;">
        <Label text="📊 Your Portfolio Assets" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <VBox spacing="5" style="-fx-hgrow: always; -fx-alignment: center_right;">
            <Label fx:id="lblPortfolioValue" text="💰 0.00" 
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #00ff88;"/>
            <Label fx:id="lblAssetCount" text="0 assets" style="-fx-font-size: 12; -fx-text-fill: #cccccc;"/>
        </VBox>
    </HBox>

    <!-- Charts Section -->
    <HBox spacing="20" VBox.vgrow="NEVER" style="-fx-padding: 0 0 20 0;">
        <!-- Asset Distribution (Pie Chart) -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
            <Label text="Répartition par actifs" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 10;"/>
            <javafx.scene.chart.PieChart fx:id="distributionChart" legendVisible="true" prefHeight="250" legendSide="RIGHT"/>
        </VBox>
        
        <!-- Capital Evolution (Line Chart) -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.1); -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
            <Label text="Evolution du capital (30 jours)" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 10;"/>
            <javafx.scene.chart.LineChart fx:id="evolutionChart" legendVisible="false" prefHeight="250" createSymbols="false">
                <xAxis>
                    <javafx.scene.chart.CategoryAxis fx:id="xAxis" animated="false" tickLabelFill="white"/>
                </xAxis>
                <yAxis>
                    <javafx.scene.chart.NumberAxis fx:id="yAxis" forceZeroInRange="false" animated="false" tickLabelFill="white"/>
                </yAxis>
            </javafx.scene.chart.LineChart>
        </VBox>
    </HBox>

    <!-- Assets Table -->
    <TableView fx:id="assetsTable" style="-fx-font-size: 12; -fx-padding: 20;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colAssetId" text="ID" prefWidth="60">
                <cellValueFactory><PropertyValueFactory property="assetId"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colAssetName" text="Asset Name" prefWidth="180">
                <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colAssetSymbol" text="Symbol" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="symbol"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colAssetPrice" text="Unit Price ($)" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="price"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colQty" text="Quantity" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="quantity"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colTotalValue" text="Total Value ($)" prefWidth="150">
                <cellValueFactory><PropertyValueFactory property="totalValue"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

</VBox>
