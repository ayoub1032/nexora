<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.P2PContractViewController"
            fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: transparent;">

    <VBox spacing="24" style="-fx-padding: 32;" VBox.vgrow="ALWAYS">
        <Label text="P2P Marketplace" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1e293b;"/>
        <Label text="List your assets for sale or place a buy order with other users." styleClass="small-label"/>

        <!-- CREATE CONTRACT SECTION -->
        <VBox spacing="16" styleClass="card">
            <VBox spacing="4" styleClass="card-header">
                <Label text="Create New Contract" styleClass="section-title"/>
            </VBox>

            <HBox spacing="16" alignment="BOTTOM_LEFT">
                <!-- Asset Selection -->
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Select Asset" styleClass="small-label"/>
                    <ComboBox fx:id="cbAsset" maxWidth="Infinity"/>
                </VBox>

                <!-- Contract Type -->
                <VBox spacing="8" style="-fx-min-width: 140px;">
                    <Label text="Contract Type" styleClass="small-label"/>
                    <ComboBox fx:id="cbContractType" maxWidth="Infinity"/>
                </VBox>

                <!-- Quantity -->
                <VBox spacing="8" style="-fx-min-width: 120px;">
                    <Label text="Quantity" styleClass="small-label"/>
                    <TextField fx:id="tfQuantity" promptText="0" />
                </VBox>

                <!-- Price per Unit -->
                <VBox spacing="8" style="-fx-min-width: 140px;">
                    <Label text="Price per Unit" styleClass="small-label"/>
                    <TextField fx:id="tfPrice" promptText="0.00" onKeyReleased="#updateTotalPrice"/>
                </VBox>

                <!-- Create Button -->
                <Button onAction="#createContract" text="Publish Contract" styleClass="btn-primary" style="-fx-min-width: 140px;"/>
            </HBox>

            <!-- Message Label -->
            <Label fx:id="lblMsg" text="" styleClass="label-error"/>
        </VBox>

        <!-- AVAILABLE CONTRACTS TABLE -->
        <VBox spacing="16">
            <Label text="Open Contracts" styleClass="section-title"/>
            <TableView fx:id="contractsTable" styleClass="table-view" VBox.vgrow="ALWAYS" style="-fx-min-height: 400px;">
                <columns>
                    <TableColumn fx:id="colCreator" text="Creator" prefWidth="120"/>
                    <TableColumn fx:id="colReputation" text="Reputation" prefWidth="160"/>
                    <TableColumn fx:id="colAsset" text="Asset" prefWidth="120"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="80"/>
                    <TableColumn fx:id="colQuantity" text="Quantity" prefWidth="80"/>
                    <TableColumn fx:id="colPrice" text="Price/Unit" prefWidth="100"/>
                    <TableColumn fx:id="colTotal" text="Total Value" prefWidth="120"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Action Buttons -->
            <HBox spacing="16" alignment="CENTER_RIGHT">
                <Button fx:id="btnShowQr" onAction="#showQrCode" text="Show QR Code" visible="false" styleClass="btn-ghost" style="-fx-border-color: #cbd5e1;"/>
                <Button onAction="#acceptSelectedContract" text="Accept Selected Contract" styleClass="btn-primary" style="-fx-padding: 12 30;"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
