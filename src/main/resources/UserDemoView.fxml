<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.UserDemoViewController"
            styleClass="admin-page">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="admin-topbar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="USER MODE" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Retour" onAction="#back" styleClass="btn-ghost"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="admin-scroll">
            <VBox spacing="16" styleClass="admin-content">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <!-- Wallet Card -->
                <VBox spacing="12" styleClass="card-light">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <Label text="Gestion du Wallet" styleClass="section-title"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="ID Wallet:" styleClass="small-label"/>
                        <TextField fx:id="tfWalletId" promptText="ID" prefWidth="100"/>
                        <Button text="Charger" onAction="#loadWallet" styleClass="btn-primary"/>
                        <Button text="Refresh" onAction="#refreshAll" styleClass="btn-ghost"/>
                    </HBox>

                    <Label fx:id="lblInfo" text="" styleClass="note"/>

                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <VBox>
                            <Label text="Wallet ID" styleClass="kpi-title"/>
                            <Label fx:id="lblWallet" text="-" styleClass="kpi-value"/>
                        </VBox>
                        <VBox>
                            <Label text="Balance" styleClass="kpi-title"/>
                            <Label fx:id="lblBalance" text="-" styleClass="kpi-value-green"/>
                        </VBox>
                        <VBox>
                            <Label text="Reserved" styleClass="kpi-title"/>
                            <Label fx:id="lblReserved" text="-" styleClass="kpi-value"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Transactions Card -->
                <VBox spacing="12" styleClass="card-light">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <Label text="Nouvelle Opération" styleClass="section-title"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Type" styleClass="small-label"/>
                            <ComboBox fx:id="cbType" prefWidth="140"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Montant" styleClass="small-label"/>
                            <TextField fx:id="tfAmount" promptText="0.00" prefWidth="140"/>
                        </VBox>

                         <VBox spacing="4">
                            <Label text="Ref (opt)" styleClass="small-label"/>
                            <TextField fx:id="tfRef" promptText="123" prefWidth="120"/>
                        </VBox>
                        
                        <VBox alignment="BOTTOM_LEFT">
                             <Button text="Valider" onAction="#submit" styleClass="btn-primary"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="lblOpMsg" text="" styleClass="note"/>
                </VBox>

                <!-- History Card -->
                <VBox spacing="12" styleClass="card-light">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Historique Transactions" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <TextField fx:id="tfUpdateBalance" promptText="Solde" prefWidth="80"/>
                            <Button text="Update" onAction="#updateWallet" styleClass="btn-ghost"/>
                        </HBox>

                        <Button text="Delete" onAction="#deleteTransaction" styleClass="btn-danger"/>
                        <Button text="Clear" onAction="#clearSelection" styleClass="btn-ghost"/>
                    </HBox>

                    <TableView fx:id="txTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="colTxId" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="colTxAmount" text="Montant" prefWidth="140"/>
                            <TableColumn fx:id="colTxType" text="Type" prefWidth="120"/>
                            <TableColumn fx:id="colTxRef" text="Ref" prefWidth="100"/>
                            <TableColumn fx:id="colTxStatus" text="Status" prefWidth="120"/>
                            <TableColumn fx:id="colTxCreated" text="Date" prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>