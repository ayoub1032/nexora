<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.UserOrdersController"
            fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: transparent;">

    <VBox spacing="24" style="-fx-padding: 32;" VBox.vgrow="ALWAYS">
        <Label text="My Active Orders" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1e293b;"/>
        <Label text="A complete history of your BUY and SELL executions." styleClass="small-label"/>
        
        <Label fx:id="lblMsg" text=""/>
        
        <TableView fx:id="ordersTable" styleClass="table-view" VBox.vgrow="ALWAYS" style="-fx-min-height: 500px;">
            <columns>
                <TableColumn fx:id="colOrderId" text="Order Reference" prefWidth="120" style="-fx-alignment: CENTER; -fx-text-fill: #64748b;"/>
                <TableColumn fx:id="colOrderAssetId" text="Asset ID" prefWidth="100" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colOrderType" text="Action" prefWidth="120" style="-fx-alignment: CENTER; -fx-font-weight: 800;"/>
                <TableColumn fx:id="colOrderQuantity" text="Quantity" prefWidth="150" style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colOrderPrice" text="Total Execution Value" prefWidth="200" style="-fx-alignment: CENTER-RIGHT; -fx-text-fill: #0d9488;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</ScrollPane>
