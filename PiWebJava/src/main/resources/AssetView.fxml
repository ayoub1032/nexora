<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AssetViewController">

    <top>
        <VBox spacing="10" styleClass="content-header">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label text="Assets Management" styleClass="title"/>
            <HBox spacing="10">
                <TextField fx:id="tfFilterName" promptText="Filter by Name..." HBox.hgrow="ALWAYS"/>
                <Button onAction="#refreshAssets" text="🔄 Refresh" styleClass="btn-primary"/>
                <Button onAction="#back" text="← Back" styleClass="btn-ghost"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="12" style="-fx-padding: 16px;">
                <TableView fx:id="assetTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAssetId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colName" text="Name" prefWidth="120"/>
                        <TableColumn fx:id="colSymbol" text="Symbol" prefWidth="80"/>
                        <TableColumn fx:id="colValue" text="Value" prefWidth="80"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="10" styleClass="form-container" style="-fx-margin: 16px;">
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="tfName" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Symbol:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="tfSymbol" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Value:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="tfValue" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="tfType" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label fx:id="lblMsg" text="" styleClass="label-error" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4"/>

                <HBox spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
                    <Button onAction="#addAsset" text="➕ Add" styleClass="btn-primary"/>
                    <Button onAction="#updateAsset" text="✏️ Update" styleClass="btn-primary"/>
                    <Button onAction="#deleteAsset" text="🗑️ Delete" styleClass="btn-danger"/>
                    <Button onAction="#clearFields" text="Clear" styleClass="btn-ghost"/>
                </HBox>
            </GridPane>
        </VBox>
    </bottom>

</BorderPane>
